# Copy to .env and fill in. Variables marked (optional) can stay empty.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local docker-compose database:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/arcadeide"

# --- Authentication (NextAuth) -----------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# (optional) OAuth sign-in. Buttons only appear when both values are set.
# Callback URLs: <NEXTAUTH_URL>/api/auth/callback/google and .../github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Realtime + code execution backend (server/) -----------------------------
# Public URL of the backend. Baked into the client at build time.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
# Must match ROOM_TOKEN_SECRET in server/.env. Generate with: openssl rand -base64 32
ROOM_TOKEN_SECRET="arcadeide-dev-secret-change-me"

# --- AI assistant (optional) -------------------------------------------------
# Without a key the AI menu reports that it is not configured.
OPENAI_API_KEY=""
# (optional) Any OpenAI-compatible provider, e.g. Gemini, Groq or OpenRouter.
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# --- Profile pictures (optional, Cloudinary unsigned upload preset) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- Voice chat TURN server (optional) ---------------------------------------
# Needed only for users behind strict NATs/firewalls. Comma separated URLs.
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""
