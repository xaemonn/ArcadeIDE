# Copy to server/.env for local development.

PORT=4000

# Origins of the Next.js app allowed to connect (comma separated).
# A "*" matches one DNS label, e.g. https://arcadeide-*.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Shared with the Next.js app (ROOM_TOKEN_SECRET there). Must be identical.
# Generate one with: openssl rand -base64 32
ROOM_TOKEN_SECRET=arcadeide-dev-secret-change-me

# --- Code execution (all optional) ---
# EXEC_CONCURRENCY=2              # programs running at the same time
# EXEC_QUEUE_LIMIT=20             # programs allowed to wait for a slot
# EXEC_TIMEOUT_MS=10000           # wall-clock limit per run
# EXEC_COMPILE_TIMEOUT_MS=30000
# EXEC_MAX_OUTPUT_BYTES=65536
# EXEC_RATE_LIMIT_PER_MINUTE=30   # runs per user per minute (preview gets 4x)
# EXEC_UID=10001                  # set by the Docker image
# EXEC_GID=10001
# ALLOW_UNSANDBOXED_EXEC=false    # never enable on a public server
